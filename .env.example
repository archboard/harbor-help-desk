APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# false for self-hosted (single workspace); HARBOR_DOMAIN defaults to the APP_URL host
HARBOR_MULTITENANT=true
# HARBOR_DOMAIN=
# Multitenant only: comma-separated emails allowed to open /horizon
# HARBOR_HORIZON_EMAILS=

# OAuth signing keys; defaults to storage/oauth-*.key from `php artisan passport:keys`.
# Set these when running more than one app instance. The install scripts generate them,
# on one line in double quotes with literal \n between the PEM lines.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# Docker installs: the release tag to run (default latest) and the host port the app
# container publishes for your TLS reverse proxy. VM installs record the deployed tag.
# HARBOR_VERSION=
# HARBOR_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=harbor_help
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Keep SESSION_DOMAIN unset/null: host-only cookies keep workspace subdomains apart.
SESSION_DOMAIN=null
# Defaults to true when APP_URL is https.
# SESSION_SECURE_COOKIE=true
# Proxies whose X-Forwarded-* headers are trusted: "*" behind a load balancer, or IPs/CIDRs.
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# App email is sent through each workspace's notification mailbox; MAIL_MAILER must stay `workspace`.
MAIL_MAILER=workspace
# HARBOR_PLATFORM_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Hosted inbound mailboxes through Postmark; leave unset to use only connected mailboxes
# HARBOR_INBOUND_DOMAIN=in.example.com
# HARBOR_POSTMARK_WEBHOOK_SECRET=

# Connected IMAP/OAuth mailboxes are polled every minute on their own queue. Run a worker for it:
#   php artisan queue:work --queue=mail-poll
# Two to four workers keep up with about 100 mailboxes a minute (~1s per poll, mostly network).
# For new mail within seconds, also supervise `php artisan mailboxes:watch` (like queue:work).
# One process covers ~100 mailboxes; run more with --shard=N --shards=M.
# HARBOR_MAIL_WATCH=false
# HARBOR_MAIL_WATCH_INTERVAL=10

# OAuth apps for connecting Google and Microsoft 365 mailboxes
# GOOGLE_MAIL_CLIENT_ID=
# GOOGLE_MAIL_CLIENT_SECRET=
# MICROSOFT_MAIL_CLIENT_ID=
# MICROSOFT_MAIL_CLIENT_SECRET=
# MICROSOFT_MAIL_TENANT=common

# Provider push: Gmail needs a Pub/Sub topic (projects/…/topics/…) whose push subscription posts
# to {APP_URL}/webhooks/google/gmail?token={HARBOR_MAIL_PUSH_SECRET}; Microsoft Graph posts to
# {APP_URL}/webhooks/microsoft/graph. Both need a public APP_URL. Without these, OAuth mailboxes
# are polled or watched instead.
# GOOGLE_MAIL_PUBSUB_TOPIC=
# HARBOR_MAIL_PUSH_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (realtime). REVERB_HOST/PORT/SCHEME are the public-facing values browsers connect to.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
